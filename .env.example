# ── Provider settings ────────────────────────────────────────────
# Required: your Brave Search API key
MCP_BRAVE_API_KEY=your-brave-api-key-here

# ── Server settings ─────────────────────────────────────────────
MCP_BRAVE_HOST=0.0.0.0
MCP_BRAVE_PORT=8100
MCP_BRAVE_LOG_LEVEL=info
MCP_BRAVE_ENVIRONMENT=production

# Optional: require a bearer token for incoming requests from the
# MCP hub.  If blank, all requests are accepted.
MCP_BRAVE_AUTH_TOKEN=

# ── Brave API tuning ────────────────────────────────────────────
# MCP_BRAVE_BASE_URL=https://api.search.brave.com/res/v1
# MCP_BRAVE_RATE_LIMIT_RPS=1
# MCP_BRAVE_REQUEST_TIMEOUT=15

# ── Observability ───────────────────────────────────────────────
# MCP_BRAVE_SENTRY_DSN=
# MCP_BRAVE_OPENTELEMETRY_ENDPOINT=
